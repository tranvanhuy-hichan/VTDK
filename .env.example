# ========================================================
# 🚀 MODULAR FEATURE FLAGS (ENABLE / DISABLE MODULES)
# Set to 'false' to disable a feature. Default is 'true'.
# ========================================================
NEXT_PUBLIC_FEATURE_B2B_QUOTATION=true        # Studio Báo Giá B2B Admin (/admin/quote)
NEXT_PUBLIC_FEATURE_SELF_SERVICE_QUOTE=true   # Khách tự tải Báo Giá PDF từ Giỏ Hàng
NEXT_PUBLIC_FEATURE_POS_TERMINAL=true         # Trạm Bán Hàng Tại Quầy POS (/admin/pos)
NEXT_PUBLIC_FEATURE_SHARE_CART=true           # Chia sẻ giỏ hàng qua link Zalo/Facebook
NEXT_PUBLIC_FEATURE_QUICK_BUY=true            # Nút Mua Ngay siêu tốc
NEXT_PUBLIC_FEATURE_DELIVERY_SLIP=true        # In Phiếu Xuất Kho Kiêm Giao Hàng 4 Chữ Ký
NEXT_PUBLIC_FEATURE_ORDER_TRACKING=true       # Tra cứu đơn hàng công khai (/don-hang/[code])
NEXT_PUBLIC_FEATURE_VIETQR_PAYMENT=true       # Tự động tạo mã QR chuyển khoản VietQR
NEXT_PUBLIC_FEATURE_VAT_CALCULATION=true      # Tính thuế GTGT / VAT (0%, 8%, 10%)
NEXT_PUBLIC_FEATURE_THEME_CUSTOMIZER=true     # Bộ tùy biến giao diện Theme Engine (/admin/theme)
NEXT_PUBLIC_FEATURE_ANALYTICS=true            # Báo cáo Analytics Doanh thu (/admin/analytics)
NEXT_PUBLIC_FEATURE_MEDIA_GALLERY=true        # Thư viện Media Gallery (/admin/gallery)
NEXT_PUBLIC_FEATURE_SERVICES=true             # Phân hệ Giải pháp dịch vụ (/admin/services)
NEXT_PUBLIC_FEATURE_CUSTOMER_PORTAL=true      # Tài khoản thành viên & Đăng nhập

