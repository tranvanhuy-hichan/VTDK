generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  seoH1       String?
  seoTitle    String?
  seoDesc     String?
  seoContent  String?
  features    String[]  @default([])
  products    Product[]
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  price       Int
  shortDesc   String?
  image       String    // cover image, e.g. /uploads/xxx.webp
  images      String[]  @default([]) // additional gallery images
  active      Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, createdAt])
  @@index([categoryId])
}

model ProductVariant {
  id         String   @id @default(uuid())
  label      String   // e.g. "Độ dày 13mm", "183cm"
  price      Int
  sortOrder  Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  features    String[]
  icon        String   @default("ThermometerSun")
  image       String    // cover image
  images      String[] @default([]) // additional gallery images
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// Single-row table holding editable company contact info
model CompanyInfo {
  id              String   @id @default(uuid())
  name            String   @default("Công ty TNHH Vật Tư Đông Kha")
  fullName        String   @default("Công ty TNHH Vật Tư Đông Kha")
  shortName       String   @default("VẬT TƯ ĐÔNG KHA")
  brandName       String   @default("Đông Kha")
  tagline         String   @default("VẬT TƯ ĐIỆN LẠNH ĐÀ NẴNG")
  city            String   @default("Đà Nẵng")
  address         String
  hotline         String
  hotlineRaw      String
  email           String?
  taxCode         String?
  zaloUrl         String
  whatsAppUrl     String
  facebookUrl     String
  googleMapsUrl   String
  googleMapsEmbed String
  workingHours    String
  hasDelivery     Boolean  @default(false)
  logoUrl         String   @default("/images/logo.png")
  image           String   @default("/images/storefront.png") // cover image
  images          String[] @default([]) // additional gallery images
  
  // Theme & Styling Customization (White-Label Dynamic Theming)
  primaryColor    String   @default("#075FA8")
  primaryDark     String   @default("#0B1F33")
  primaryLight    String   @default("#EBF3FA")
  accentColor     String   @default("#F47A20")
  accentHover     String   @default("#E06912")
  fontFamily      String   @default("Be Vietnam Pro")
  borderRadius    String   @default("rounded-xl")
  headerStyle     String   @default("standard")
  themePreset     String   @default("ocean-blue")
  customCss       String?

  updatedAt       DateTime @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING     // Chờ xử lý / Đơn mới
  CONFIRMED   // Đã xác nhận
  SHIPPING    // Đang giao hàng
  COMPLETED   // Đã hoàn thành
  CANCELLED   // Đã hủy
}

enum ShippingMethod {
  STORE_PICKUP // Đến lấy tại cửa hàng (không cần nhập địa chỉ)
  DELIVERY     // Giao hàng tận nơi (bắt buộc nhập địa chỉ)
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   // Null nếu chỉ đăng nhập qua Google
  name         String
  phone        String?
  address      String?   // Địa chỉ giao hàng được ghi nhớ cho các lần mua sau
  role         Role      @default(CUSTOMER)
  googleId     String?   @unique
  avatar       String?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model Order {
  id             String         @id @default(uuid())
  orderCode      String         @unique // Ví dụ: DK-260824-A89F
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  shippingMethod ShippingMethod @default(DELIVERY)
  address        String?        // Bắt buộc nếu là DELIVERY, null nếu là STORE_PICKUP
  note           String?
  totalAmount    Int
  status         OrderStatus    @default(PENDING)
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([orderCode])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  productSlug  String
  productName  String
  variantLabel String?
  price        Int
  quantity     Int
  image        String

  @@index([orderId])
}

